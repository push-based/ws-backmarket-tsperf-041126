{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "incremental": false,
    "paths": { "@utils/*": ["./utils/*.fixed.ts"] }
  },
  "files": ["./index.fixed.ts"]
}
